# =====================================================================
# AutoTasker Backend — Environment Variables
# Copy to `.env` and fill in your real secrets.
# =====================================================================

# --- Runtime ---
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...             # optional fallback
META_AGENT_MODEL=claude-opus-4-6
WORKER_MODEL=claude-haiku-4-5-20251001

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# --- Postgres (used by LangGraph AsyncPostgresSaver) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1                     # 1 in local dev, 0 in prod

# --- Browserbase / Stagehand (optional for Phase 1) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
